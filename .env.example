# Luma Anbudsvarsling — environment template.
# Copy to .env for local development. .env is git-ignored and must stay that way.
# Spec section 48 is the authoritative list. Two deliberate differences:
#   - DOFFIN_SUBSCRIPTION_KEY replaces the spec's DOFFIN_API_KEY / CLIENT_ID / CLIENT_SECRET.
#   - REDIS_URL is absent: the queue is pg-boss on the main PostgreSQL (ADR-8).

NODE_ENV=development
LOG_LEVEL=debug

# --- Data -------------------------------------------------------------------
DATABASE_URL=postgres://luma:luma@localhost:5432/luma_anbudsvarsling

# --- Service URLs -----------------------------------------------------------
APP_URL=http://localhost:3000
API_URL=http://localhost:8080
MCP_URL=http://localhost:8081

# --- Authentication ---------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-me-with-at-least-32-random-characters
AUTH_EMAIL_FROM=ikke-svar@luma-training.com
ADMIN_EMAIL_ALLOWLIST=

# --- Doffin -----------------------------------------------------------------
DOFFIN_API_BASE_URL=https://api.doffin.no
DOFFIN_SUBSCRIPTION_KEY=

# --- Postmark ---------------------------------------------------------------
POSTMARK_SERVER_TOKEN=
POSTMARK_ACCOUNT_TOKEN=
POSTMARK_TRANSACTIONAL_STREAM=transactional
POSTMARK_TENDER_NOTIFICATION_STREAM=tender-notifications
POSTMARK_MARKETING_STREAM=luma-marketing
POSTMARK_WEBHOOK_USERNAME=postmark
POSTMARK_WEBHOOK_PASSWORD=replace-me

# --- Tokens -----------------------------------------------------------------
MCP_TOKEN_PEPPER=replace-me-with-at-least-32-random-characters
SHARE_TOKEN_SECRET=replace-me-with-at-least-32-random-characters
SHARE_DEFAULT_TTL_DAYS=30
CRON_SECRET=replace-me-with-at-least-32-random-characters

# --- Legal ------------------------------------------------------------------
LUMA_PRIVACY_POLICY_URL=https://luma-training.com/personvern
TENDER_SERVICE_TERMS_URL=http://localhost:3000/vilkar
CURRENT_PRIVACY_POLICY_VERSION=2026-01-01
CURRENT_TERMS_VERSION=1.0
CURRENT_MARKETING_CONSENT_TEXT_VERSION=1.0

# --- Billing (manual invoicing only in MVP, spec section 28) ----------------
BILLING_PROVIDER=manual
BILLING_ADMIN_EMAIL=faktura@luma-training.com
DEFAULT_VAT_PERCENT=25

# --- Editorial routing (spec section 23.2) ----------------------------------
# Comma-separated region codes that qualify for the Oslo-only full-day course.
OSLO_REGION_CODES=NO081,NO082

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
ANALYTICS_KEY=
