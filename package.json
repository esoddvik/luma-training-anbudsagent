{
  "name": "luma-anbudsvarsling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,yaml,yml}\"",
    "check:citations": "node scripts/check-citations.js",
    "check:spec-copy": "node scripts/check-spec-copy.js",
    "db:generate": "pnpm --filter @luma/db db:generate",
    "db:migrate": "pnpm --filter @luma/db db:migrate",
    "db:studio": "pnpm --filter @luma/db db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "catalog:",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.6",
    "tsx": "catalog:",
    "turbo": "^2.10.8",
    "typescript": "catalog:",
    "typescript-eslint": "^8.65.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
