{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env.example", "tsconfig.base.json"],
  // DATABASE_URL is passed through deliberately. The integration suites in
  // @luma/db and core skip themselves when it is absent, so without it here
  // turbo would report a green run that quietly skipped every test that talks
  // to a real database — the most valuable ones in the repository.
  "globalEnv": ["NODE_ENV", "LOG_LEVEL", "DATABASE_URL", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
